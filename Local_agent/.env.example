# Local Agent 全局配置（前缀 LA_）

# 仅本机调试；局域网访问可改为 0.0.0.0
LA_HOST=127.0.0.1
LA_PORT=8770

# Server Center（本机联调 http；远程部署改为 https://你的域名）
LA_SERVER_CENTER_URL=http://127.0.0.1:8765
LA_MODULE_NAME=网页爬取模块
# 与 Server SC_WIRE_ENCRYPT 保持一致（默认开启）
LA_WIRE_ENCRYPT=true

# 本地模型（OpenAI 兼容，默认 Ollama）
LA_LLM_BASE_URL=http://127.0.0.1:11434/v1
LA_LLM_API_KEY=ollama
LA_LLM_MODEL=llama3.2
LA_LLM_TIMEOUT=120

# 环境感知（采集 20s / 总结 600s）
LA_ENV_COLLECT_INTERVAL_SECONDS=20
LA_ENV_SUMMARY_INTERVAL_SECONDS=600
LA_ENV_PING_TARGET=8.8.8.8
LA_ENV_CPU_ALERT_PERCENT=90
LA_ENV_MEMORY_ALERT_PERCENT=90
LA_ENV_DISK_FREE_ALERT_GB=5
LA_ENV_PING_LOSS_ALERT_PERCENT=10
LA_ENV_PING_LATENCY_ALERT_MS=500
LA_ENV_CAMERA_INDEX=0

# RAG（Chroma + nomic-embed-text）
LA_RAG_DEFAULT_COLLECTION=default
LA_RAG_EMBED_MODEL=nomic-embed-text
LA_RAG_EMBED_BASE_URL=http://127.0.0.1:11434/v1
LA_RAG_CHUNK_SIZE=800
LA_RAG_CHUNK_OVERLAP=120
# 分块：rule | semantic | semantic_embedding | structural
LA_RAG_SPLIT_MODE=rule
LA_RAG_SPLIT_MODEL=qwen2.5:3b
# 策略③ 向量断点
LA_RAG_MIN_CHUNK_SIZE=50
LA_RAG_EMBED_BREAKPOINT_THRESHOLD=0.35
LA_RAG_EMBED_BREAKPOINT_PERCENTILE=75
LA_RAG_TOP_K=5
LA_RAG_MIN_SCORE=0.25
# true: 本地小模型阅读检索结果后总结；false: 直接返回召回片段
LA_RAG_SUMMARIZE=true

# 安全检查
LA_SECURITY_APPROVAL_TIMEOUT_SECONDS=300
LA_SECURITY_USE_MODEL_FOR_YELLOW=true
LA_SECURITY_CHAT_CONTEXT_YELLOW_LIMIT=5
LA_SECURITY_CHAT_CONTEXT_APPROVAL_LIMIT=5

# 记忆模块（独立 Chroma + nomic-embed-text）
LA_MEMORY_EMBED_MODEL=nomic-embed-text
LA_MEMORY_EMBED_BASE_URL=http://127.0.0.1:11434/v1
LA_MEMORY_WORKING_MAX_SIZE=20
LA_MEMORY_WORKING_KEEP_AFTER_CONSOLIDATE=10
LA_MEMORY_CONTEXT_LIMIT=10
LA_MEMORY_RECALL_TOP_K=5
LA_MEMORY_REFLECTION_MIN_IMPORTANCE=6
LA_MEMORY_RELEVANCE_VECTOR_WEIGHT=0.65
LA_MEMORY_RELEVANCE_TAG_WEIGHT=0.35

# 执行模块（默认工作目录为 Local_agent 根；可改为绝对路径，启动时自动加入白目录）
# LA_EXECUTOR_DEFAULT_CWD=C:/Users/you/project/Local_agent
LA_EXECUTOR_TIMEOUT_SECONDS=300
LA_EXECUTOR_SHELL=powershell

# 远程终端（网页 cmd，不经 AI 执行与安全检查）
LA_TERMINAL_ENABLED=true
# LA_TERMINAL_SHELL=cmd

# 心智 / 情感模块（默认关闭：主对话与接入前一致；工作台可开关）
LA_EMOTION_ENABLED=false
LA_EMOTION_PERSONA=default
# LA_EMOTION_PERSONAS_DIR=  # 可选自定义目录；空则用模块内 personas/
