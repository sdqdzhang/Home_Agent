# Local Agent 全局配置（前缀 LA_）

LA_HOST=0.0.0.0
LA_PORT=8770

# Server Center
LA_SERVER_CENTER_URL=http://127.0.0.1:8765
LA_MODULE_NAME=网页爬取模块

# 本地模型（OpenAI 兼容，默认 Ollama）
LA_LLM_BASE_URL=http://127.0.0.1:11434/v1
LA_LLM_API_KEY=ollama
LA_LLM_MODEL=llama3.2
LA_LLM_TIMEOUT=120

# 环境感知（采集 20s / 总结 600s）
LA_ENV_COLLECT_INTERVAL_SECONDS=20
LA_ENV_SUMMARY_INTERVAL_SECONDS=600
LA_ENV_PING_TARGET=8.8.8.8
LA_ENV_CPU_ALERT_PERCENT=90
LA_ENV_MEMORY_ALERT_PERCENT=90
LA_ENV_DISK_FREE_ALERT_GB=5
LA_ENV_PING_LOSS_ALERT_PERCENT=10
LA_ENV_PING_LATENCY_ALERT_MS=500
LA_ENV_CAMERA_INDEX=0
